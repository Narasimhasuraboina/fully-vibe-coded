# Public Matrix homeserver selected for the initial $0 setup.
MATRIX_HOMESERVER_URL=https://matrix.org
VITE_MATRIX_HOMESERVER_URL=https://matrix.org

# Set by most hosting platforms automatically.
PORT=3001

# Enables production security headers, including the Matrix connection policy.
NODE_ENV=production

# Set to 1 only when running behind a trusted reverse proxy that supplies forwarded headers.
TRUST_PROXY=1
