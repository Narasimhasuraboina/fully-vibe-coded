# Set to comma-separated browser origins only when the frontend is hosted separately.
# ALLOWED_ORIGINS=https://chatforge.example.com

# Set to the number of trusted reverse proxy hops, or leave unset for direct access.
TRUST_PROXY=1

# Set by most hosting platforms automatically.
PORT=3001
NODE_ENV=production

# Optional persistent data directory. Defaults to ./data.
# DATA_DIR=/var/lib/chatforge
