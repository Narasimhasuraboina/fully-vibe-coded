{
  "name": "chatforge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"node --watch-path=server/server.js server/server.js\" \"vite\"",
    "start": "node server/server.js",
    "serve": "npm run build && node server/server.js",
    "server": "node server/server.js",
    "client": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "agent-browser": "^0.35.2",
    "concurrently": "^10.0.5",
    "oxlint": "^1.75.0",
    "vite": "^8.3.1"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
